[Unit]
Description=Persistent coder user manager and D-Bus session
Requires=user@1000.service
After=systemd-logind.service user@1000.service
Before=workspace-startup.service workspace-ssh.service code-server.service

[Service]
Type=oneshot
User=coder
Group=coder
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/systemctl --user start dbus.socket dbus.service
RemainAfterExit=yes
