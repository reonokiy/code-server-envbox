FROM ecr-public.aws.com/a1y5s4n2/talos/code-server:4.140.0-ts1.102.4-7a5a8c73d624b84369ea8a8dc1bf000961e12ab9@sha256:635d1389e06a818460c8405ac4806c3e3970465bb8ac97425c09db35ad4a6bc8
LABEL org.opencontainers.image.source="https://github.com/reonokiy/code-server-envbox"
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd-sysv dbus dbus-user-session libpam-systemd \
      docker.io docker-cli docker-buildx docker-compose openssh-server sudo \
      build-essential pkg-config autoconf automake libtool \
      libssl-dev libffi-dev zlib1g-dev libbz2-dev liblzma-dev libzstd-dev \
      libreadline-dev libsqlite3-dev libncurses-dev libgdbm-dev libgdbm-compat-dev \
      uuid-dev libcurl4-openssl-dev libpq-dev libsasl2-dev \
      libxml2-dev libxslt1-dev libexpat1-dev libicu-dev \
      libjpeg-dev libpng-dev libfreetype-dev libfontconfig1-dev tk-dev \
      curl ca-certificates file unzip zip rsync xz-utils bzip2 \
      less procps lsof iproute2 iputils-ping dnsutils netcat-openbsd socat \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* \
    && usermod -a -G root,docker coder \
    && printf 'coder ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/workspace \
    && chmod 0440 /etc/sudoers.d/workspace
COPY workspace-start.py /usr/local/bin/workspace-start
COPY user-session.sh /etc/profile.d/workspace-user-session.sh
COPY sshd_config /etc/ssh/sshd_workspace_config
COPY systemd/ /etc/systemd/system/
# Sysbox supplies container mounts; host kernel mounts/sysctls are unavailable.
# Keep the existing writable /tmp rather than requesting another tmpfs mount.
RUN chmod 0755 /usr/local/bin/workspace-start \
    && printf 'code.nokiy.net\n' > /etc/hostname \
    && systemctl mask ssh.service ssh.socket \
         sys-kernel-config.mount sys-kernel-debug.mount sys-kernel-tracing.mount \
         tmp.mount systemd-sysctl.service systemd-modules-load.service \
    && mkdir -p /var/lib/systemd/linger \
    && touch /var/lib/systemd/linger/coder \
    && systemctl enable workspace.target
ENV container=docker
STOPSIGNAL SIGRTMIN+3
USER 1000:1000
