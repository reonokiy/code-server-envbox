FROM ghcr.io/tailscale/tailscale:v1.104.4@sha256:ed6480b33c6eb67c9cbd203ed42b9fb57e361986725b6856def71b7a3d9e276c AS tailscale
FROM ecr-public.aws.com/a1y5s4n2/talos/code-server:4.141.0-ts1.104.1-c546dca0de5f8fe57e5b3fffc3eb085507fd197e@sha256:de54f36e7afaea486785e812b9e5699d190675a46fde550d386b8ba26b4e65de
LABEL org.opencontainers.image.source="https://github.com/reonokiy/code-server-envbox"
USER root
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
COPY --from=tailscale /usr/local/bin/containerboot /usr/local/bin/containerboot
# Match inner coder UID/GID 1000 after Envbox's namespace offset. Native
# Tailscale SFTP can access the shared files without an elevated broker.
RUN groupmod -g 101000 coder \
    && usermod -u 101000 -g 101000 -s /usr/local/bin/workspace-shell coder \
    && groupadd -g 100000 workspace-data \
    && usermod -a -G workspace-data coder \
    && chown -R 101000:101000 /home/coder
COPY workspace-shell.py /usr/local/bin/workspace-shell
COPY tailnet-start.py /usr/local/bin/tailnet-start
RUN chmod 0755 /usr/local/bin/workspace-shell /usr/local/bin/tailnet-start
USER 101000:101000
