Port 2222
ListenAddress 0.0.0.0
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers coder
AuthorizedKeysFile /run/relay/public/authorized_key
UsePAM yes
Subsystem sftp internal-sftp
AllowTcpForwarding yes
X11Forwarding no
PrintMotd no

# Native relay commands do not necessarily start a login shell.
SetEnv XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
